# Application
APP_NAME=EskomSense-AI
APP_ENV=development
DEBUG=true
PORT=8000

# Model Settings
SEQUENCE_LENGTH=24
HIDDEN_SIZE=128
NUM_LAYERS=2
DROPOUT=0.2
LEARNING_RATE=0.001
EPOCHS=50
BATCH_SIZE=32
VAL_SPLIT=0.2
EARLY_STOP_PATIENCE=7
SEED=42

# Paths
MODEL_PATH=models/
DATA_PATH=data/
DEVICE=auto
